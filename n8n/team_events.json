    {
      "parameters": {
        "jsCode": "// Dedupe on the outbox event id. The dispatcher sends it as X-Idempotency-Key\n// and as body.id; a retried delivery carries the same id.\nconst request = $input.first().json;\nconst body = request.body ?? {};\nconst eventId = request.headers['x-idempotency-key'] ?? body.id;\nif (!eventId) {\n  throw new Error('Event without id: no X-Idempotency-Key header and no body.id');\n}\nconst delivered = $getWorkflowStaticData('global').delivered ?? [];\nreturn [\n  {\n    json: {\n      event_id: eventId,\n      event_type: body.event_type,\n      tenant_id: body.tenant_id,\n      payload: body.payload ?? {},\n      duplicate: delivered.includes(eventId),\n    },\n  },\n];\n"
      },
