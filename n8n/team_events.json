      "id": "87481b61-93f1-5028-b6a2-6ce4728730ca",
      "name": "Send push to team",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1160,
        380
      ],
      "notes": "Publishes to the push server in the Compose stack. Fails when sending fails.",
      "notesInFlow": true
    },
    {
      "parameters": {
        "jsCode": "// The id is stored only here, after the channel node succeeded. A failed\n// notification leaves no mark, so the dispatcher's retry is processed again\n// instead of being answered as a duplicate.\nconst KEEP = 1000;\nconst store = $getWorkflowStaticData('global');\nconst eventId = $('Seen before?').first().json.event_id;\nconst delivered = store.delivered ?? [];\nif (!delivered.includes(eventId)) {\n  delivered.push(eventId);\n}\nstore.delivered = delivered.slice(-KEEP);\nreturn [{ json: { event_id: eventId } }];\n"
      },
      "id": "0f237cf9-4e7a-5b2e-9b43-1b48a127fbb5",
      "name": "Remember event id",
