# ── Datenbank ───────────────────────────────────────────────
POSTGRES_USER=maex
POSTGRES_PASSWORD=change_me
POSTGRES_DB=maex_agent
DATABASE_URL=postgresql+psycopg://maex:change_me@db:5432/maex_agent
# On the server the application gets a database role of its own, without superuser
# (docs/13 §3); outside ENV=dev and ENV=test the API does not start as a superuser.
# DATABASE_URL then names that role and OWNER_DATABASE_URL the user above, who
# migrates, dumps and restores. `bash scripts/db_role.sh` creates the role with the
# password given here. The workbench keeps the single user: tests and evals create
# their own databases.
# DATABASE_URL=postgresql+psycopg://maex_app:<openssl rand -hex 24>@db:5432/maex_agent
# OWNER_DATABASE_URL=postgresql+psycopg://maex:<POSTGRES_PASSWORD>@db:5432/maex_agent

# ── Agent-API ───────────────────────────────────────────────
# In production the API does not start on this placeholder or on fewer than 32
# characters: openssl rand -hex 32
AGENT_API_TOKEN=change_me_long_random
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENV=dev

# ── GUI-Zugang (nur Produktion, Caddy schützt /gui/*) ───────
# Hash erzeugen: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<PASSWORT>'
# User and hash together (e.g. team): both empty close the view for everyone, one
# without the other stops Caddy from starting, and with it bridge and health.
GUI_BASIC_AUTH_USER=
GUI_BASIC_AUTH_HASH=
# Shared by Caddy and the API: in production the view answers only requests
# that came through Caddy (docs/13 §3). Empty closes the view there.
# openssl rand -hex 32, never the value of AGENT_API_TOKEN.
GUI_PROXY_SECRET=

# -- Production only: names and the access to the n8n editor (deploy/Caddyfile) --
# The three names Caddy answers to. Commented out, the placeholders apply.
# AGENT_DOMAIN=agent.example.com
# N8N_DOMAIN=n8n.example.com
# PUSH_DOMAIN=push.example.com
# The workflow editor gets its own user, never the one of the tablet. Both empty:
# the editor is closed for everyone; one without the other stops Caddy from
# starting. Hash as above; single quotes, a hash contains "$".
N8N_EDITOR_AUTH_USER=
N8N_EDITOR_AUTH_HASH=

# ── Mandant ─────────────────────────────────────────────────
TENANT_NAME=<Firmenname>
TENANT_TIMEZONE=Europe/Berlin
TEAM_PHONE=+49000000000
# Written into a new tenant by the seed. A call, on the phone line and on the
# text phone, is ended by the tenant's value (service_config.max_call_seconds).
MAX_CALL_SECONDS=420
# Where the privacy notice is, written into a new tenant by the seed
# (service_config.privacy_notice_address). The phone greeting reads it out as
# written here, so write it the way a caller should hear it, for example
# example.com/datenschutz. Empty: the greeting leaves the sentence out. Set
# before the first real call (docs/09 §1 L4).
PRIVACY_NOTICE_ADDRESS=

# ── Own voice layer: services `voice` and `asterisk` (docs/20 §7) ──
# Started only with the Compose profile `voice` (COMPOSE_PROFILES=voice, or
# `docker compose --profile voice up -d`). Neither starts with a value missing.
# TEAM_PHONE above is where the dialplan sends a call when `voice` cannot say.
# Asterisk presents the token on the media channel and when it asks how a call
# ended: openssl rand -hex 32
VOICE_MEDIA_TOKEN=
# The number the AI telephone answers, E.164. Never the team's number.
VOICE_NUMBER=
# Ear and mouth: `whisper` and `piper`, the local engines of the test phase.
# `fake` is the drill pair of the workbench and refused outside ENV=dev and
# ENV=test.
VOICE_EAR=whisper
VOICE_MOUTH=piper
# Whisper on the graphics card (cuda) or on the processor (cpu, seconds per
# sentence). The Piper voice by its file name among the model files, which
# `voice` reads from deploy/speech/run/models (docker-compose.yml).
VOICE_EAR_DEVICE=cuda
VOICE_MOUTH_VOICE=de_DE-thorsten-medium
# Seconds of silence before the code asks "Sind Sie noch da?".
VOICE_SILENCE_SECONDS=8
# Prices of the voice layer in whole euro cents (T-10.6, docs/20 §9): the ear
# per hour of audio, the mouth per million characters, a transfer leg per hour.
# With the model's prices and the first two set, a phone call's cost goes into
# the call log; without one it stays empty, and so does the cost of a call with
# a team leg when the third is missing. The local engines and the router of
# the test phase cost 0. A transfer leg with a price above 0 leaves the cost
# empty until the line reports the leg's length (T-10.12).
# VOICE_EAR_CENTS_PER_HOUR=0
# VOICE_MOUTH_CENTS_PER_MCHAR=0
# VOICE_OUTBOUND_CENTS_PER_HOUR=0
# The numbers besides TEAM_PHONE a transfer may go to, comma-separated, as
# written in service_config.team_phone; blanks are dropped, and so is
# TEAM_PHONE itself. The dialplan dials no other number: one `voice` names that
# is not here rings TEAM_PHONE instead, and a number here nobody takes is
# followed by TEAM_PHONE. A mailbox that answers takes the call, so no number
# here with a mailbox (docs/20 §5). Empty: every transfer goes to TEAM_PHONE.
# Asterisk only.
TRANSFER_TARGETS=
# Where Asterisk registers: the pilot's router in the test phase, a SIP trunk
# in operation (docs/20 §3). Asterisk only, never read by Python. Asterisk
# takes SIP only from the IPv4 addresses of the servers its _sip._udp SRV
# records name, or of ACCESS_HOST itself without such records, looked up when
# it starts; a lookup that fails stops the start until DNS answers.
ACCESS_HOST=
ACCESS_USER=
ACCESS_PASSWORD=

# ── Language model of the conversation core (T-2.4) ─────────
# Any server that speaks the chat completions API. Empty: no model, the text
# phone and the evals run on the scripted stand-in.
# Workbench, a local model with invented test data only (docs/13 §0):
#   LLM_BASE_URL=http://localhost:11434/v1          (Ollama, started on the host)
#   LLM_BASE_URL=http://host.docker.internal:11434/v1   (from inside a container,
#     Docker Desktop only: on a Linux Docker Engine the name does not exist and
#     Ollama listens on loopback only; run the text phone on the host there)
#   LLM_MODEL=qwen3:14b      (the workbench model, docs/18 §5; any name that
#     `ollama list` prints works), LLM_API_KEY stays empty
#   LLM_TIMEOUT_SECONDS=60   (a local model loads into memory on its first call:
#     14 to 20 s measured; with 15 that call times out and hands over)
#   LLM_REASONING_EFFORT=none   (needed for qwen3, see below)
# Operation: a hosted model with processing in the EU and a signed DPA.
# With these set, `--model <name>` in the text phone and the eval runner picks a
# model on this server (`make eval MODEL=qwen3:14b`); `LLM_MODEL` is the default
# for code that asks for "the configured model".
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
# The longest one request to the model may take. On the phone line a request is
# cut off earlier, after what is left of the tenant's deadline for one guest turn
# (service_config.turn_deadline_seconds, 10 by default); never later than this.
LLM_TIMEOUT_SECONDS=15
# Sent as `reasoning_effort` when set. A reasoning model (qwen3) needs `none`:
# without it the model thinks until the output limit and answers nothing
# (87 s, no JSON; docs/18 §5). Empty: the parameter is not sent, for servers
# that do not know it.
LLM_REASONING_EFFORT=
# Upper limit for one answer in tokens. A turn is a sentence or a tool call; a
# model that reasons before it answers needs more.
LLM_MAX_OUTPUT_TOKENS=600
# Price of the model in euro cents per million tokens, whole numbers. With both
# set, a call's model cost goes into the call log (`calls.cost_cents`, whole
# cents, rounded up). Without them the cost stays empty; the tokens are logged
# either way. A local model costs 0. Leave the lines commented out rather than
# empty: an empty value is not a number. The prices belong to LLM_MODEL: a run
# with another model (`--model`, `make eval MODEL=...`) gets no cost.
# LLM_INPUT_CENTS_PER_MTOK=0
# LLM_OUTPUT_CENTS_PER_MTOK=0

# ── n8n ─────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://n8n:5678/webhook/maex
# Credential of the webhook node, sent by the dispatcher (n8n/README.md). It does
# not protect the editor: that is n8n's owner account and, in production, Caddy.
# Outside ENV=dev and test, while the user is set, the password needs 32 characters
# (openssl rand -hex 32), or the dispatcher does not start.
N8N_BASIC_AUTH_USER=maex
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_TIMEOUT_SECONDS=10
# The key n8n encrypts its stored credentials with, n8n only. Optional: without
# it n8n uses the key it wrote into its volume at the first start. Set it only to
# that key, copied from the volume (docs/13 §3); a different one stops n8n.
# N8N_ENCRYPTION_KEY=
DISPATCHER_INTERVAL_SECONDS=5
DISPATCHER_BATCH=20

# ── Push server for team notifications (D13, n8n/README.md) ─
# Address under which the team's devices reach the push server.
NTFY_BASE_URL=http://localhost:8090
# Without the next two lines the server starts without users, closed for
# everyone. Single quotes are required, a hash contains "$".
#   Hash:  docker run --rm -it binwiederhier/ntfy:v2.31.1 user hash
#   Token: docker run --rm binwiederhier/ntfy:v2.31.1 token generate
# NTFY_AUTH_USERS='team:<hash>:user,n8n:<hash>:user'
# NTFY_AUTH_TOKENS='n8n:<token>:n8n workflow'

# Druckbruecke im Lokal (T-4.6, printbridge/README.md): holt Kuechenbons ab.
# Leer lassen, solange keine Bruecke laeuft - dann ist /v1/kitchen/* zu.
# Outside ENV=dev and test: 32 characters or more (openssl rand -hex 32), never the
# value of AGENT_API_TOKEN, or the API does not start; the proxy offers it to the internet.
KITCHEN_BRIDGE_TOKEN=
# UUID des Betriebs, fuer den das Token gilt (Pflicht, sonst ist der Eingang zu).
KITCHEN_BRIDGE_TENANT_ID=

# ── Backup (docs/13 §4) ─────────────────────────────────────
# File with the passphrase for the dumps, outside the repo, readable only by the
# backup user. Without it scripts/backup.sh writes nothing.
BACKUP_PASSPHRASE_FILE=
BACKUP_KEEP_DAYS=14
# Compose network of the stack, so the client container reaches `db`. Needed on the
# server, and on a Linux workbench without a local Postgres client (docs/13 §2).
BACKUP_DOCKER_NETWORK=

# ── Suche ───────────────────────────────────────────────────
MENU_FUZZY_THRESHOLD_HIGH=0.72
MENU_FUZZY_THRESHOLD_LOW=0.45

# ── Anrufprotokoll (docs/17) ────────────────────────────────
# Löschfrist der CSV in Tagen, entschieden 24.09.2026 (D10)
CALL_LOG_RETENTION_DAYS=90

# ── Deletion job (docs/03 "Löschkonzept", T-11.2) ───────────
# Periods in days, decided with the legal check on 20.10.2026 (L8, L13),
# each from 1 to 3660; the interval at most 86400 (one day).
# The dispatcher process runs the job every RETENTION_INTERVAL_SECONDS.
RETENTION_CALLER_ID_DAYS=90
RETENTION_GUEST_DETAILS_DAYS=90
RETENTION_CALLBACK_DAYS=90
RETENTION_OUTBOX_SENT_DAYS=7
RETENTION_OUTBOX_UNSENT_DAYS=30
RETENTION_OUTBOX_ROW_DAYS=90
RETENTION_AUDIT_LOG_DAYS=365
# Business days after the one of the order or reservation; 0 is the night after.
RETENTION_ALLERGY_NOTE_DAYS=0
# Calendar years after the year of a consent answer (1 to 10); 3 deletes an
# answer from 2026 on 01.01.2030.
RETENTION_CONSENT_LOG_YEARS=3
RETENTION_INTERVAL_SECONDS=3600

# ── Register report (T-11.6, docs/09 §1 L18) ─────────────────
# Local hour (5 to 23) from which the team gets one push a day naming how
# many orders of earlier business days nobody marked "In Kasse eingegeben".
REGISTER_REPORT_HOUR=10
