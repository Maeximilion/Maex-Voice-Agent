# ── Datenbank ───────────────────────────────────────────────
POSTGRES_USER=maex
POSTGRES_PASSWORD=change_me
POSTGRES_DB=maex_agent
DATABASE_URL=postgresql+psycopg://maex:change_me@db:5432/maex_agent

# ── Agent-API ───────────────────────────────────────────────
AGENT_API_TOKEN=change_me_long_random
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
ENV=dev

# ── GUI-Zugang (nur Produktion, Caddy schützt /gui/*) ───────
# Hash erzeugen: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<PASSWORT>'
GUI_BASIC_AUTH_USER=team
GUI_BASIC_AUTH_HASH=

# ── Mandant ─────────────────────────────────────────────────
TENANT_NAME=<Firmenname>
TENANT_TIMEZONE=Europe/Berlin
TEAM_PHONE=+49000000000
MAX_CALL_SECONDS=420

# ── Voice-Plattform (nach Entscheidung D1 füllen) ───────────
VOICE_PROVIDER=
VOICE_API_KEY=
VOICE_WEBHOOK_SECRET=

# ── Language model of the conversation core (T-2.4) ─────────
# Any server that speaks the chat completions API. Empty: no model, the text
# phone and the evals run on the scripted stand-in.
# Workbench, a local model with invented test data only (docs/13 §0):
#   LLM_BASE_URL=http://localhost:11434/v1          (Ollama, started on the host)
#   LLM_BASE_URL=http://host.docker.internal:11434/v1   (from inside a container,
#     Docker Desktop only: on a Linux Docker Engine the name does not exist and
#     Ollama listens on loopback only; run the text phone on the host there)
#   LLM_MODEL=<name as `ollama list` prints it>, LLM_API_KEY stays empty
#   LLM_TIMEOUT_SECONDS=60   (a local model loads into memory on its first call:
#     18 to 20 s measured; with 15 that call times out and hands over)
# Operation: a hosted model with processing in the EU and a signed DPA.
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=15
# Upper limit for one answer in tokens. A turn is a sentence or a tool call; a
# model that reasons before it answers needs more.
LLM_MAX_OUTPUT_TOKENS=600
# Price of the model in euro cents per million tokens, whole numbers. With both
# set, a call's model cost goes into the call log (`calls.cost_cents`, whole
# cents, rounded up). Without them the cost stays empty; the tokens are logged
# either way. A local model costs 0. Leave the lines commented out rather than
# empty: an empty value is not a number.
# LLM_INPUT_CENTS_PER_MTOK=0
# LLM_OUTPUT_CENTS_PER_MTOK=0

# ── n8n ─────────────────────────────────────────────────────
N8N_WEBHOOK_URL=http://n8n:5678/webhook/maex
N8N_BASIC_AUTH_USER=maex
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_TIMEOUT_SECONDS=10
DISPATCHER_INTERVAL_SECONDS=5
DISPATCHER_BATCH=20

# ── Push server for team notifications (D13, n8n/README.md) ─
# Address under which the team's devices reach the push server.
NTFY_BASE_URL=http://localhost:8090
# Without the next two lines the server starts without users, closed for
# everyone. Single quotes are required, a hash contains "$".
#   Hash:  docker run --rm -it binwiederhier/ntfy:v2.28.0 user hash
#   Token: docker run --rm binwiederhier/ntfy:v2.28.0 token generate
# NTFY_AUTH_USERS='team:<hash>:user,n8n:<hash>:user'
# NTFY_AUTH_TOKENS='n8n:<token>:n8n workflow'

# Druckbruecke im Lokal (T-4.6, printbridge/README.md): holt Kuechenbons ab.
# Leer lassen, solange keine Bruecke laeuft - dann ist /v1/kitchen/* zu.
KITCHEN_BRIDGE_TOKEN=
# UUID des Betriebs, fuer den das Token gilt (Pflicht, sonst ist der Eingang zu).
KITCHEN_BRIDGE_TENANT_ID=

# ── Backup (docs/13 §4) ─────────────────────────────────────
# File with the passphrase for the dumps, outside the repo, readable only by the
# backup user. Without it scripts/backup.sh writes nothing.
BACKUP_PASSPHRASE_FILE=
BACKUP_KEEP_DAYS=14
# Compose network of the stack, so the client container reaches `db`. Needed on the
# server, and on a Linux workbench without a local Postgres client (docs/13 §2).
BACKUP_DOCKER_NETWORK=

# ── Suche ───────────────────────────────────────────────────
MENU_FUZZY_THRESHOLD_HIGH=0.72
MENU_FUZZY_THRESHOLD_LOW=0.45

# ── Anrufprotokoll (docs/17) ────────────────────────────────
# Löschfrist der CSV in Tagen, entschieden 24.09.2026 (D10)
CALL_LOG_RETENTION_DAYS=90
