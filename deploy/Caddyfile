# The three names come from .env on the server (AGENT_DOMAIN, N8N_DOMAIN,
# PUSH_DOMAIN), so going live changes no tracked file. The defaults are
# placeholders (CLAUDE.md §1).
#
# No `log` directive on purpose: Caddy writes no access log, and its own
# messages go to the container log, which the server keeps 14 days
# (deploy/journald.conf, T-11.7). An access log, if one is ever needed, goes
# there too, never to a file (api/tests/test_log_periods.py).
(transport) {
    # A browser that reached the site once never falls back to plain HTTP,
    # where the shared access of the tablet could be read off the line.
    header Strict-Transport-Security "max-age=31536000"
}

{$AGENT_DOMAIN:agent.example.com} {
    import transport
    encode gzip

    # Die Betriebsansicht zeigt Gastnamen, Telefonnummern und Notizen. Die
    # Anwendung selbst kennt keinen Browser-Zugang (docs/06 §6: ein gemeinsamer
    # Zugang je Gerät), deshalb steht er hier davor. Benutzer und Hash kommen
    # aus der Umgebung, nie aus dem Repo (CLAUDE.md §8).
    # Hash erzeugen: docker run --rm caddy:2-alpine caddy hash-password --plaintext '<PASSWORT>'
    @gui path /gui /gui/*
    basic_auth @gui {
        {$GUI_BASIC_AUTH_USER} {$GUI_BASIC_AUTH_HASH}
    }
    # No browser guesses a type from content, and no address of the view, which
    # can carry an order or call id, leaves in a Referer header.
    header X-Content-Type-Options "nosniff"
    header Referrer-Policy "no-referrer"
    # The view loads only its own files (no CDN, no inline code: docs/06 §2,
    # api/gui/static/base.js), so a future XSS can run nothing and send nothing
    # elsewhere. The buttons act on one tap; no other page may frame them.
    header @gui Content-Security-Policy "default-src 'self'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"

    # Public is what something outside this server needs: the operations view,
    # the print bridge in the restaurant and the health check. The tools and
    # the call endpoints under /v1 are used inside the Docker network only (the
    # voice layer runs on this server, docs/20) and are not proxied: a token
    # that is never offered to the internet cannot be tried from there.
    @public path /gui /gui/* /v1/kitchen/* /health
    handle @public {
        # Forms and the bridge send a few hundred bytes.
        request_body {
            max_size 256KB
        }
        # The view answers only requests that carry this secret, so a container
        # on the Docker network cannot reach it around the Basic-Auth above
        # (api/core/auth.py). Set here, it replaces a header a client sent.
        reverse_proxy api:8000 {
            header_up X-Maex-Proxy-Secret "{env.GUI_PROXY_SECRET}"
        }
    }
    handle {
        respond 404
    }
}

{$N8N_DOMAIN:n8n.example.com} {
    import transport

    # The editor of the workflows. n8n 2 ignores N8N_BASIC_AUTH_*: without this
    # block the first visitor of a fresh instance creates the owner account, and
    # from inside n8n the operations view is reachable without any access check.
    # The dispatcher does not come through here, it posts to n8n:5678 inside the
    # Docker network. Hash as above.
    basic_auth {
        {$N8N_EDITOR_AUTH_USER} {$N8N_EDITOR_AUTH_HASH}
    }
    reverse_proxy n8n:5678
}

# Push server for the team's devices (D13). It checks access itself: closed by
# default, the user "team" may only read the topic "team" (docker-compose.yml).
{$PUSH_DOMAIN:push.example.com} {
    import transport
    reverse_proxy push:80
}
