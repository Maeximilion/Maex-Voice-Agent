# Shell scripts and the crontab run on Linux and in Git Bash; CRLF breaks both.
*.sh text eol=lf
*.cron text eol=lf
# Generated by scripts/readme_assets.py: collapsed in diffs, never merged by hand.
# On a conflict, take either side and run `make readme-assets`.
.github/assets/*.svg linguist-generated=true
# Compiled from api/gui/ts/ by `npm run build` (docs/22): collapsed in diffs, and LF
# on every machine, because CI compares the committed file with a fresh build.
api/gui/static/raumplan-geometry.js linguist-generated=true text eol=lf
api/gui/static/base.js linguist-generated=true text eol=lf
api/gui/static/raumplan.js linguist-generated=true text eol=lf
api/gui/static/app.js linguist-generated=true text eol=lf
api/gui/ts/*.ts text eol=lf
# Measurements are appended by a run on any branch: a merge keeps the rows of both
# sides, and `readme_assets.py render` drops a row that came in twice.
docs/metrics/*.csv merge=union
# Archive of docs/01_STATUS.md: entries are only added, so a merge keeps both sides.
docs/HISTORY.md merge=union
